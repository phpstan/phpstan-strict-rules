<?php

namespace StrictCalls;

function searchBool(bool $bool) {
    array_search(false, [$bool], true);
}

in_array(1, [1, 2], true);
in_array(1, [1, 2], true);
array_keys([1, 2], 1, true);
$strict = rand(0, 1) === 1;
array_keys([1, 2], 1, true);
in_array(1, [1.0]);
in_array(1, [1.0], false);
in_array(1, [1, 1.0]);
in_array('1', ['01']);

$float = 1.0;
in_array($float, [1.0]);
in_array(null, [null]);

/** @return int[] */
function getArray(): array
{
	return [1, 2];
}

function doFoo(int $i): bool
{
	return in_array($i, getArray());
}

array_keys([1, 2]);
base64_decode('abcd');

$numericStringNeedle = '01'; // edge case: numeric string compared against int-string: https://3v4l.org/hmgdd#v
in_array($numericStringNeedle, ['1', '2']);

class X {
	private const TYPES = [128, 256];

	function doFoo(int $i):bool {
		return in_array($i, self::TYPES, true);
	}
}
