<?php

namespace StrictCalls;

in_array(1, [1, 2], true);
in_array(1, [1, 2], true);
array_search(false, [true, false], true);
array_keys([1, 2], 1, true);
$strict = rand(0, 1) === 1;
array_keys([1, 2], 1, true);
in_array(1, [1.0]);
in_array(1, [1.0], false);
in_array(1, [1, 1.0]);
in_array('1', ['01']);
$float = 1.0;
in_array($float, [1.0]);
in_array(null, [null]);

/** @return int[] */
function getArray(): array
{
	return [1, 2];
}

function doFoo(int $i): bool
{
	return in_array($i, getArray());
}

array_keys([1, 2]);
base64_decode('abcd');
